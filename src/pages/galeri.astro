---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/common/Container.astro";
import SectionHeader from "@/components/common/SectionHeader.astro";
import Button from "@/components/common/Button.astro";
import { siteConfig } from "@/config/site";
import { getPublishedNews } from "@/utils/content";
import { formatDate } from "@/utils/date";

type GalleryItem = {
  image: string;
  title: string;
  description: string;
  sourceUrl: string;
  sourceTitle: string;
};

const news = await getPublishedNews();
const seenImages = new Set<string>();

const gallery = news.flatMap((item) => {
  const sourceUrl = `/berita/${item.slug}`;
  const sourceDate = formatDate(item.data.publishedAt);
  const images: GalleryItem[] = [];

  if (item.data.cover) {
    seenImages.add(item.data.cover);
    images.push({
      image: item.data.cover,
      title: item.data.coverAlt ?? item.data.title,
      description: `Foto utama dari berita "${item.data.title}" yang dipublikasikan pada ${sourceDate}.`,
      sourceUrl,
      sourceTitle: item.data.title
    });
  }

  for (const match of item.body.matchAll(/!\[([^\]]*)\]\(([^)]+)\)/g)) {
    const [, altText, image] = match;

    if (!image || seenImages.has(image)) {
      continue;
    }

    seenImages.add(image);
    images.push({
      image,
      title: altText || item.data.title,
      description: `Dokumentasi dari berita "${item.data.title}" yang dipublikasikan pada ${sourceDate}.`,
      sourceUrl,
      sourceTitle: item.data.title
    });
  }

  return images;
});

---

<BaseLayout title="Galeri" description="Dokumentasi kegiatan, pembinaan, kolaborasi, dan pengabdian HDMI Kabupaten Bone.">
  <section class="py-16 md:py-24">
    <Container>
      <SectionHeader eyebrow="Galeri" title="Potret Perjalanan Dakwah" description="Dokumentasi dari berbagai kegiatan, perjumpaan, pembinaan, dan pengabdian HDMI Kabupaten Bone." />
      {gallery.length > 0 ? (
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {gallery.map((item) => (
            <a href={item.sourceUrl} aria-label={`Buka berita: ${item.sourceTitle}`} class="group block overflow-hidden rounded-2xl border border-border bg-white">
              <img src={item.image} alt={item.title} class="aspect-[4/3] w-full bg-surface-soft object-cover transition duration-200 group-hover:scale-[1.02]" loading="lazy" decoding="async" />
            </a>
          ))}
        </div>
      ) : (
        <div class="rounded-2xl border border-dashed border-border bg-surface-soft px-6 py-12 text-center">
          <p class="text-sm font-bold uppercase text-primary-deep">Galeri belum tersedia</p>
          <p class="mx-auto mt-3 max-w-xl text-sm leading-6 text-body">
            Dokumentasi kegiatan akan ditambahkan setelah materi foto resmi siap dipublikasikan.
          </p>
        </div>
      )}
    </Container>
  </section>

  <section class="bg-surface-soft py-16 md:py-24">
    <Container>
      <div class="mb-10 grid gap-6 lg:grid-cols-[1fr_auto] lg:items-end">
        <SectionHeader eyebrow="Instagram" title="Feed Terbaru HDMI Bone" description="Embed profil Instagram resmi HDMI Kabupaten Bone untuk melihat pembaruan publikasi langsung dari akun resmi." />
        <Button href={siteConfig.instagramUrl} target="_blank" rel="noopener noreferrer">Ikuti {siteConfig.instagram}</Button>
      </div>

      <div class="mb-8 overflow-hidden rounded-2xl border border-border bg-white p-4 shadow-sm">
        <div class="flex justify-center">
          <blockquote
            class="instagram-media"
            data-instgrm-permalink={siteConfig.instagramUrl}
            data-instgrm-version="14"
            style="background:#fff; border:0; margin:0 auto; max-width:540px; min-width:326px; width:100%;"
          >
            <a href={siteConfig.instagramUrl} target="_blank" rel="noopener noreferrer" class="block rounded-xl bg-surface-soft px-6 py-8 text-center text-sm font-bold text-primary-deep">
              Buka profil Instagram {siteConfig.instagram}
            </a>
          </blockquote>
        </div>
      </div>
    </Container>
    <script is:inline async src="https://www.instagram.com/embed.js"></script>
  </section>
</BaseLayout>
