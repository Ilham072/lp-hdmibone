      ["Nur Fitria Wahyuni, S.Pd.", "Anggota"],
      ["Nurul Aulia Ramadhani, S.Pd.", "Anggota"],
      ["Maria Ulfa, S.Pd.", "Anggota"],
      ["Iftah Amellia, S.Pd.", "Anggota"],
