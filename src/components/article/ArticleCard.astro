---
import Badge from "@/components/common/Badge.astro";
import { formatDate } from "@/utils/date";

const { item, horizontal = false } = Astro.props;
const imageClass = horizontal ? "aspect-[4/3] h-full" : "aspect-[16/10]";
---

<article class:list={[
  "overflow-hidden rounded-2xl border border-border bg-white transition hover:-translate-y-0.5 hover:shadow-soft",
  horizontal && "md:grid md:grid-cols-[240px_1fr]"
]}>
  <a href={`/artikel/${item.slug}`} class={horizontal ? "contents" : "block"}>
    <img src={item.data.cover ?? "/images/logo-hdmi-bone.png"} alt={item.data.coverAlt ?? item.data.title} class:list={["w-full bg-surface-soft object-contain p-6", imageClass]} loading="lazy" />
    <div class="p-6">
      <div class="mb-4 flex flex-wrap items-center gap-3">
        <Badge tone="secondary">{item.data.category}</Badge>
        <time class="text-sm text-muted" datetime={item.data.publishedAt.toISOString()}>{formatDate(item.data.publishedAt)}</time>
      </div>
      <h3 class="text-xl font-bold leading-snug text-ink">{item.data.title}</h3>
      <p class="mt-3 text-sm leading-6 text-body">{item.data.excerpt}</p>
      <span class="mt-5 inline-flex text-sm font-bold text-primary-deep">Baca Artikel</span>
    </div>
  </a>
</article>
