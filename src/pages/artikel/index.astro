---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/common/Container.astro";
import SectionHeader from "@/components/common/SectionHeader.astro";
import ArticleCard from "@/components/article/ArticleCard.astro";
import { getPublishedArticles } from "@/utils/content";

const articles = await getPublishedArticles();
const [featured, ...rest] = articles;
---

<BaseLayout title="Artikel" description="Artikel dan wawasan HDMI Kabupaten Bone tentang dakwah, generasi muda, keluarga, masjid, dan masyarakat.">
  <section class="py-16 md:py-24">
    <Container>
      <SectionHeader eyebrow="Artikel & Wawasan" title="Menumbuhkan Gagasan, Menyalakan Kesadaran" description="Bacaan seputar dakwah, generasi muda, keluarga, masjid, kepemimpinan, dan tantangan umat." />
      {featured ? (
        <div class="grid gap-6">
          <ArticleCard item={featured} horizontal />
          <div class="grid gap-6">
            {rest.map((item) => <ArticleCard item={item} horizontal />)}
          </div>
        </div>
      ) : (
        <div class="rounded-2xl bg-surface-soft p-8 text-center">
          <h2 class="text-2xl font-bold text-ink">Artikel Sedang Disiapkan</h2>
          <p class="mt-3 text-body">Tulisan dan wawasan terbaru dari HDMI Kabupaten Bone akan segera hadir.</p>
        </div>
      )}
    </Container>
  </section>
</BaseLayout>
