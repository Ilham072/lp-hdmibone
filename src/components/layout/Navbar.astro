---
import { siteConfig } from "@/config/site";

const links = [
  ["Beranda", "/"],
  ["Tentang", "/tentang"],
  ["Program", "/program"],
  ["Berita", "/berita"],
  ["Artikel", "/artikel"],
  ["Galeri", "/galeri"],
  ["Kontak", "/kontak"]
];
---

<header class="sticky top-0 z-50 border-b border-border bg-white/90 backdrop-blur">
  <nav class="mx-auto flex h-16 max-w-7xl items-center justify-between px-5 sm:px-8 lg:h-[72px] lg:px-10" aria-label="Navigasi utama">
    <a href="/" class="flex items-center gap-3">
      <img src={siteConfig.logo} alt="Logo HDMI Kabupaten Bone" class="h-11 w-auto" />
      <span class="sr-only">{siteConfig.name}</span>
    </a>
    <div class="hidden items-center gap-7 lg:flex">
      {links.map(([label, href]) => (
        <a href={href} class="text-sm font-semibold text-body transition hover:text-primary-deep">{label}</a>
      ))}
    </div>
    <a href="/kontak" class="hidden rounded-full bg-dark px-5 py-3 text-sm font-semibold text-white transition hover:bg-dark-soft lg:inline-flex">
      Mari Berkolaborasi
    </a>
    <details class="relative lg:hidden">
      <summary class="flex min-h-11 cursor-pointer list-none items-center rounded-full border border-border px-4 text-sm font-semibold text-ink">
        Menu
      </summary>
      <div class="absolute right-0 mt-3 w-64 rounded-2xl border border-border bg-white p-3 shadow-soft">
        {links.map(([label, href]) => (
          <a href={href} class="block min-h-11 rounded-xl px-4 py-3 text-sm font-semibold text-body hover:bg-surface-soft hover:text-primary-deep">{label}</a>
        ))}
        <a href="/kontak" class="mt-2 flex min-h-11 items-center justify-center rounded-full bg-primary px-4 py-3 text-sm font-semibold text-ink">Mari Berkolaborasi</a>
      </div>
    </details>
  </nav>
</header>
