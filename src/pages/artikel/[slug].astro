---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/common/Container.astro";
import Breadcrumb from "@/components/common/Breadcrumb.astro";
import Badge from "@/components/common/Badge.astro";
import ArticleCard from "@/components/article/ArticleCard.astro";
import { formatDate } from "@/utils/date";
import { getRelatedArticles } from "@/utils/content";
import { siteConfig } from "@/config/site";
import { buildAbsoluteUrl, buildCanonical, buildPublisherSchema } from "@/utils/seo";

export async function getStaticPaths() {
  const items = (await getCollection("artikel")).filter((item) => !item.data.draft && item.data.publishedAt <= new Date());
  return items.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

const { item } = Astro.props;
const { Content } = await item.render();
const related = await getRelatedArticles(item.slug, 3);
const canonical = buildCanonical(`/artikel/${item.slug}`);
const image = buildAbsoluteUrl(item.data.cover ?? siteConfig.ogImage);
const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: item.data.title,
  description: item.data.seoDescription ?? item.data.excerpt,
  image: [image],
  url: canonical,
  datePublished: item.data.publishedAt.toISOString(),
  dateModified: (item.data.updatedAt ?? item.data.publishedAt).toISOString(),
  author: { "@type": "Organization", name: item.data.author, url: siteConfig.domain },
  publisher: buildPublisherSchema(),
  mainEntityOfPage: canonical
};
---

<BaseLayout
  title={item.data.seoTitle ?? item.data.title}
  description={item.data.seoDescription ?? item.data.excerpt}
  image={item.data.cover}
  imageAlt={item.data.coverAlt ?? item.data.title}
  type="article"
>
  <article class="py-12 md:py-20">
    <Container>
      <Breadcrumb items={[{ label: "Beranda", href: "/" }, { label: "Artikel", href: "/artikel" }, { label: item.data.title }]} />
      <header class="mx-auto max-w-4xl">
        <Badge tone="secondary">{item.data.category}</Badge>
        <h1 class="mt-5 text-4xl font-bold leading-tight text-ink md:text-5xl">{item.data.title}</h1>
        <p class="mt-5 text-lg leading-8 text-body">{item.data.excerpt}</p>
        <p class="mt-5 text-sm text-muted">Oleh {item.data.author} · <time datetime={item.data.publishedAt.toISOString()}>{formatDate(item.data.publishedAt)}</time></p>
      </header>
      <img src={item.data.cover ?? "/images/logo-hdmi-bone.png"} alt={item.data.coverAlt ?? item.data.title} class="mx-auto mt-10 aspect-[16/9] w-full max-w-5xl rounded-3xl bg-surface-soft object-contain p-8" />
      <div class="prose-content mx-auto mt-12">
        <Content />
      </div>
      <div class="mx-auto mt-10 max-w-3xl rounded-2xl bg-surface-soft p-6">
        <h2 class="text-lg font-bold text-ink">Tentang Penulis</h2>
        <p class="mt-2 text-sm leading-6 text-body">{item.data.author} menulis konten dakwah, pembinaan, dan wawasan organisasi untuk website HDMI Kabupaten Bone.</p>
      </div>
    </Container>
  </article>
  <section class="bg-surface-soft py-16">
    <Container>
      <h2 class="mb-8 text-3xl font-bold text-ink">Artikel Terkait</h2>
      <div class="grid gap-6 md:grid-cols-3">
        {related.map((entry) => <ArticleCard item={entry} />)}
      </div>
    </Container>
  </section>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)}></script>
</BaseLayout>
