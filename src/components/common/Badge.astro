---
const { tone = "primary" } = Astro.props;
const tones = {
  primary: "bg-primary-soft text-[#00796D]",
  secondary: "bg-secondary-soft text-[#166534]",
  accent: "bg-accent-soft text-[#8A5400]"
};
---

<span class:list={["inline-flex rounded-full px-3 py-1 text-xs font-bold", tones[tone as keyof typeof tones] ?? tones.primary]}>
  <slot />
</span>
