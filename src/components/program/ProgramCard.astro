---
import ProgramMeta from "@/components/program/ProgramMeta.astro";
import type { ProgramItem } from "@/data/programs";

const { program, index } = Astro.props as { program: ProgramItem; index: number };
---

<article class="rounded-2xl border border-border bg-white p-6 shadow-sm">
  <div class="mb-5 flex items-start justify-between gap-4">
    <div>
      <p class="text-xs font-bold uppercase tracking-[0.08em] text-primary-deep">Program {index + 1}</p>
      <h3 class="mt-2 text-2xl font-bold leading-tight text-ink">{program.title}</h3>
    </div>
    <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-accent-soft text-sm font-bold text-[#8A5400]">
      {String(index + 1).padStart(2, "0")}
    </span>
  </div>

  <p class="text-base leading-7 text-body">{program.description}</p>

  <div class="mt-5">
    <ProgramMeta items={program.metas} />
  </div>

  {program.activities && program.activities.length > 0 && (
    <div class="mt-6">
      <h3 class="text-sm font-bold uppercase tracking-[0.08em] text-ink">Contoh kegiatan / aktivitas</h3>
      <ul class="mt-3 space-y-2 text-sm leading-6 text-body">
        {program.activities.map((activity) => (
          <li class="flex gap-2">
            <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-primary"></span>
            <span>{activity}</span>
          </li>
        ))}
      </ul>
    </div>
  )}

  {program.outputs && program.outputs.length > 0 && (
    <div class="mt-6 rounded-2xl bg-surface-soft p-5">
      <h3 class="text-sm font-bold uppercase tracking-[0.08em] text-ink">Output</h3>
      <ul class="mt-3 space-y-2 text-sm leading-6 text-body">
        {program.outputs.map((output) => (
          <li class="flex gap-2">
            <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-secondary"></span>
            <span>{output}</span>
          </li>
        ))}
      </ul>
    </div>
  )}
</article>
