---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/common/Container.astro";
import SectionHeader from "@/components/common/SectionHeader.astro";
import Button from "@/components/common/Button.astro";
import ProgramCard from "@/components/program/ProgramCard.astro";
import ProgramFieldCard from "@/components/program/ProgramFieldCard.astro";
import { programFields } from "@/data/programs";
---

<BaseLayout title="Program Kerja HDMI Bone 2026-2031" description="Program kerja HDMI Bone periode 2026-2031 meliputi kaderisasi, kajian dan riset, dakwah masyarakat, kemitraan, kegiatan sosial, serta pembinaan muslimah.">
  <section class="overflow-hidden bg-white py-16 md:py-24">
    <Container>
      <div class="grid gap-10 lg:grid-cols-[1fr_0.7fr] lg:items-end">
        <div>
          <p class="mb-4 text-xs font-bold uppercase tracking-[0.08em] text-primary-deep">Program Kerja 2026-2031</p>
          <h1 class="max-w-4xl text-4xl font-bold leading-tight text-ink md:text-5xl">Program Kerja HDMI Bone</h1>
          <p class="mt-6 max-w-3xl text-lg leading-8 text-body">
            Program HDMI Bone diarahkan untuk membangun kader, memperkuat dakwah berbasis ilmu, memperluas kemitraan, menghadirkan aksi sosial, dan membuka ruang pembinaan yang dekat dengan kebutuhan masyarakat.
          </p>
        </div>
        <div class="rounded-2xl border border-border bg-surface-soft p-6">
          <p class="text-sm font-bold uppercase tracking-[0.08em] text-accent">Tema Gerakan</p>
          <p class="mt-3 text-2xl font-bold leading-tight text-ink">Membentang Jalan Cahaya, Menjemput Fajar Peradaban</p>
        </div>
      </div>
    </Container>
  </section>

  <section class="bg-surface-soft py-16 md:py-24">
    <Container>
      <SectionHeader
        eyebrow="Bidang Strategis"
        title="Lima Bidang Program"
        description="Setiap bidang mempunyai fokus gerak dan program turunan yang saling menguatkan untuk menjalankan arah dakwah HDMI Bone."
      />
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {programFields.map((field) => <ProgramFieldCard field={field} />)}
      </div>
    </Container>
  </section>

  <section class="py-16 md:py-24">
    <Container>
      <SectionHeader
        eyebrow="Daftar Program"
        title="Program per Bidang"
        description="Rangkuman program berikut disusun dari dokumen program kerja HDMI Bone periode 2026-2031."
      />
      <div class="space-y-12">
        {programFields.map((field) => (
          <section id={field.slug} class="scroll-mt-28">
            <div class="mb-6 flex flex-col gap-4 border-b border-border pb-5 md:flex-row md:items-end md:justify-between">
              <div>
                <p class="text-xs font-bold uppercase tracking-[0.08em] text-primary-deep">{field.shortName}</p>
                <h2 class="mt-2 text-3xl font-bold text-ink">{field.name}</h2>
                <p class="mt-3 max-w-3xl text-base leading-7 text-body">{field.description}</p>
              </div>
              <Button href={`/program/${field.slug}`} variant="secondary">Detail Bidang</Button>
            </div>
            <div class="grid gap-6 lg:grid-cols-2">
              {field.programs.map((program, index) => <ProgramCard program={program} index={index} />)}
            </div>
          </section>
        ))}
      </div>
    </Container>
  </section>
</BaseLayout>
