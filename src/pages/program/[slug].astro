---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/common/Container.astro";
import Breadcrumb from "@/components/common/Breadcrumb.astro";
import Button from "@/components/common/Button.astro";
import ProgramCard from "@/components/program/ProgramCard.astro";
import { programFields } from "@/data/programs";

export function getStaticPaths() {
  return programFields.map((field) => ({
    params: { slug: field.slug },
    props: { field }
  }));
}

const { field } = Astro.props;
---

<BaseLayout title={`${field.name} | Program Kerja HDMI Bone`} description={field.description}>
  <section class="bg-white py-14 md:py-20">
    <Container>
      <Breadcrumb items={[{ label: "Beranda", href: "/" }, { label: "Program", href: "/program" }, { label: field.name }]} />
      <div class="grid gap-10 lg:grid-cols-[1fr_0.72fr]">
        <div>
          <p class="mb-4 text-xs font-bold uppercase tracking-[0.08em] text-primary-deep">Program Kerja</p>
          <h1 class="max-w-4xl text-4xl font-bold leading-tight text-ink md:text-5xl">{field.name}</h1>
          <p class="mt-6 max-w-3xl text-lg leading-8 text-body">{field.description}</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <Button href="/program">Semua Program</Button>
            <Button href="/kontak" variant="secondary">Buka Kolaborasi</Button>
          </div>
        </div>
        <aside class="rounded-2xl border border-border bg-surface-soft p-6">
          <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-primary-soft text-base font-bold text-primary-deep">
            {field.icon}
          </div>
          <h2 class="mt-5 text-2xl font-bold text-ink">Fokus Bidang</h2>
          <p class="mt-3 text-base leading-7 text-body">{field.summary}</p>
          <div class="mt-6 rounded-full bg-accent-soft px-4 py-2 text-center text-sm font-bold text-[#8A5400]">
            {field.programs.length} Program Utama
          </div>
        </aside>
      </div>
    </Container>
  </section>

  {(field.objectives || field.functions) && (
    <section class="bg-surface-soft py-14">
      <Container>
        <div class="grid gap-6 md:grid-cols-2">
          {field.objectives && (
            <article class="rounded-2xl border border-border bg-white p-6">
              <h2 class="text-2xl font-bold text-ink">Tujuan Bidang</h2>
              <ul class="mt-5 space-y-3 text-base leading-7 text-body">
                {field.objectives.map((objective) => (
                  <li class="flex gap-3">
                    <span class="mt-2.5 h-2 w-2 shrink-0 rounded-full bg-primary"></span>
                    <span>{objective}</span>
                  </li>
                ))}
              </ul>
            </article>
          )}
          {field.functions && (
            <article class="rounded-2xl border border-border bg-white p-6">
              <h2 class="text-2xl font-bold text-ink">Fungsi Utama</h2>
              <ul class="mt-5 space-y-3 text-base leading-7 text-body">
                {field.functions.map((item) => (
                  <li class="flex gap-3">
                    <span class="mt-2.5 h-2 w-2 shrink-0 rounded-full bg-accent"></span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </article>
          )}
        </div>
      </Container>
    </section>
  )}

  <section class="py-16 md:py-24">
    <Container>
      <div class="mb-8">
        <p class="mb-3 text-xs font-bold uppercase tracking-[0.08em] text-primary-deep">Daftar Program</p>
        <h2 class="text-3xl font-bold leading-tight text-ink md:text-4xl">Agenda {field.shortName}</h2>
      </div>
      <div class="grid gap-6 lg:grid-cols-2">
        {field.programs.map((program, index) => <ProgramCard program={program} index={index} />)}
      </div>
    </Container>
  </section>
</BaseLayout>
