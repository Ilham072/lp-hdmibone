---
import Badge from "@/components/common/Badge.astro";
import { formatDate } from "@/utils/date";

const { item } = Astro.props;
---

<article class="overflow-hidden rounded-2xl border border-border bg-white transition hover:-translate-y-0.5 hover:shadow-soft">
  <a href={`/berita/${item.slug}`} class="block">
    <img src={item.data.cover ?? "/images/logo-hdmi-bone.png"} alt={item.data.coverAlt ?? item.data.title} class="aspect-[16/10] w-full bg-surface-soft object-contain p-6" loading="lazy" />
    <div class="p-6">
      <div class="mb-4 flex flex-wrap items-center gap-3">
        <Badge>{item.data.category}</Badge>
        <time class="text-sm text-muted" datetime={item.data.publishedAt.toISOString()}>{formatDate(item.data.publishedAt)}</time>
      </div>
      <h3 class="text-xl font-bold leading-snug text-ink transition hover:text-primary-deep">{item.data.title}</h3>
      <p class="mt-3 line-clamp-3 text-sm leading-6 text-body">{item.data.excerpt}</p>
      <span class="mt-5 inline-flex text-sm font-bold text-primary-deep">Baca Berita</span>
    </div>
  </a>
</article>
