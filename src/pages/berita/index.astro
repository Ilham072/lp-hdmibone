---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/common/Container.astro";
import SectionHeader from "@/components/common/SectionHeader.astro";
import NewsCard from "@/components/news/NewsCard.astro";
import { getPublishedNews } from "@/utils/content";

const news = await getPublishedNews();
---

<BaseLayout title="Berita" description="Kabar terbaru kegiatan, pembinaan, kolaborasi, dan gerakan HDMI Kabupaten Bone.">
  <section class="py-16 md:py-24">
    <Container>
      <SectionHeader eyebrow="Berita" title="Kabar Terbaru HDMI Bone" description="Ikuti kegiatan, pembinaan, kolaborasi, dan berbagai ikhtiar dakwah HDMI Kabupaten Bone." />
      {news.length > 0 ? (
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {news.map((item) => <NewsCard item={item} />)}
        </div>
      ) : (
        <div class="rounded-2xl bg-surface-soft p-8 text-center">
          <h2 class="text-2xl font-bold text-ink">Belum Ada Berita Terbaru</h2>
          <p class="mt-3 text-body">Kabar dan kegiatan terbaru HDMI Kabupaten Bone akan hadir di halaman ini.</p>
        </div>
      )}
    </Container>
  </section>
</BaseLayout>
